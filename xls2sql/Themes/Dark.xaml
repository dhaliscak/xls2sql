<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Dark palette. Light.xaml must define the same keys; ThemeManager swaps the two.  -->
    <SolidColorBrush x:Key="Theme.WindowBackground" Color="#FF202020" />
    <SolidColorBrush x:Key="Theme.Foreground" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="Theme.ForegroundDisabled" Color="#FF7A7A7A" />

    <SolidColorBrush x:Key="Theme.ControlBackground" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="Theme.ControlBackgroundHover" Color="#FF383838" />
    <SolidColorBrush x:Key="Theme.ControlBackgroundPressed" Color="#FF262626" />
    <SolidColorBrush x:Key="Theme.ControlBorder" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="Theme.ControlBorderHover" Color="#FF6A6A6A" />
    <SolidColorBrush x:Key="Theme.Accent" Color="#FF2B88D8" />
    <SolidColorBrush x:Key="Theme.CheckGlyph" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Theme.InputBackground" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="Theme.InputReadOnlyBackground" Color="#FF262626" />
    <SolidColorBrush x:Key="Theme.InputBorder" Color="#FF4A4A4A" />

    <SolidColorBrush x:Key="Theme.PopupBackground" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="Theme.ItemHover" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Theme.ItemSelected" Color="#FF094771" />

    <SolidColorBrush x:Key="Theme.ScrollTrack" Color="#FF252525" />
    <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#FF7A7A7A" />

    <SolidColorBrush x:Key="Theme.OutputBackground" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="Theme.OutputForeground" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="Theme.OutputSelection" Color="#FF264F78" />
    <SolidColorBrush x:Key="Theme.OutputBorder" Color="#FF4A4A4A" />
</ResourceDictionary>
