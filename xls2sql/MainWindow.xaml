<Window
    x:Class="xls2sql.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:xls2sql"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="xls2sql 3.2 (by Daniel Haliscak)"
    Width="800"
    Height="450"
    Background="{DynamicResource Theme.WindowBackground}"
    Foreground="{DynamicResource Theme.Foreground}"
    ResizeMode="CanResizeWithGrip"
    mc:Ignorable="d">
    <Grid>
        <!--  Theme toggle (System / Light / Dark); overlays the top-right corner, first row keeps room for it.  -->
        <Button
            Name="btnTheme"
            Margin="0,10,10,0"
            Panel.ZIndex="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="BtnTheme_Click"
            Style="{StaticResource IconButton}" />

        <DockPanel Margin="10,10,9.6,10">
            <WrapPanel
                Margin="0,0,36,10"
                HorizontalAlignment="left"
                DockPanel.Dock="Top">
                <Label
                    x:Name="Database"
                    VerticalAlignment="Center"
                    Content="Database" />
                <TextBox
                    Name="txtDatabaseName"
                    Width="200"
                    Height="27"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    IsEnabled="True"
                    MaxLength="100"
                    TextWrapping="NoWrap" />

                <Label
                    x:Name="Table"
                    VerticalAlignment="Center"
                    Content="Table" />
                <TextBox
                    Name="txtTableName"
                    Width="200"
                    Height="27"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    IsEnabled="True"
                    MaxLength="100"
                    TextWrapping="NoWrap" />

                <CheckBox
                    Name="ckbCreateTable"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    IsChecked="True">
                    <TextBlock FlowDirection="LeftToRight" Text="Generate CREATE TABLE Script" />
                </CheckBox>
            </WrapPanel>

            <WrapPanel
                Margin="0,0,0,10"
                HorizontalAlignment="left"
                DockPanel.Dock="Top">
                <Label
                    x:Name="FirstColumn"
                    VerticalAlignment="Center"
                    Content="First Column" />
                <ComboBox
                    Name="cmbFirstColumn"
                    Width="150"
                    Margin="5"
                    Padding="5"
                    SelectedIndex="0">
                    <ComboBoxItem Content="None" />
                    <ComboBoxItem Content="Id (int, IDENTITY 1,1)" />
                    <ComboBoxItem Content="Id (NewSequentialId())" />
                </ComboBox>

                <Label
                    x:Name="Separator"
                    VerticalAlignment="Center"
                    Content="Separator" />
                <TextBox
                    Name="txtSeparator"
                    Width="100"
                    Height="27"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    IsEnabled="True"
                    PreviewTextInput="NumberValidationTextBox"
                    RenderTransformOrigin="0,0"
                    Text="1000"
                    TextWrapping="NoWrap"
                    UndoLimit="102" />

                <CheckBox
                    Name="ckbTrimWhiteSpaces"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    IsChecked="True">
                    <TextBlock FlowDirection="LeftToRight" Text="Trim White Spaces" />
                </CheckBox>

                <CheckBox
                    Name="ckbPrefferNulls"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    IsChecked="True">
                    <TextBlock FlowDirection="LeftToRight" Text="Preffer Nulls" />
                </CheckBox>
            </WrapPanel>

            <WrapPanel DockPanel.Dock="Top">
                <Label
                    x:Name="Path"
                    VerticalAlignment="Center"
                    Content="Path" />
                <TextBox
                    Name="txtFilepath"
                    Width="371"
                    Height="27"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    AllowDrop="True"
                    Drop="TxtFilepath_Drop"
                    IsReadOnly="True"
                    PreviewDragOver="TxtFilepath_PreviewDragOver"
                    TextWrapping="NoWrap" />
                <Button
                    Name="btnOpenFile"
                    Margin="0,5,5,5"
                    Padding="5"
                    Click="BtnOpenFile_Click">
                    Open File
                </Button>

                <ComboBox
                    Name="cmbWorkbook"
                    Width="100"
                    Margin="5"
                    Padding="5"
                    SelectionChanged="CmbWorkbook_SelectionChanged"
                    Visibility="Collapsed" />

                <Button
                    Name="btnExecute"
                    Margin="5"
                    Padding="5"
                    Click="BtnExecute_Click">
                    Generate
                </Button>

                <Button
                    Name="btnSave"
                    Margin="5"
                    Padding="5"
                    Click="BtnSave_Click">
                    Save
                </Button>
            </WrapPanel>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Label VerticalAlignment="Center" Content="Output" />
                    <Button
                        Name="btnCopyAll"
                        Margin="5,0,0,0"
                        Padding="5,0"
                        VerticalAlignment="Center"
                        Click="BtnCopyAll_Click"
                        Visibility="Collapsed">
                        Copy All
                    </Button>
                </StackPanel>
                <!--
                    Virtualized viewer: draws only visible rows of the UTF-8 output.
                    WPF TextBox needs ~25s to lay out a 30 MB script; AvalonEdit lays out each
                    whole INSERT line (one line per batch) and balloons memory while scrolling.
                -->
                <Border
                    Grid.Row="1"
                    BorderBrush="{DynamicResource Theme.OutputBorder}"
                    BorderThickness="1">
                    <ScrollViewer
                        CanContentScroll="True"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Visible">
                        <local:OutputViewer
                            x:Name="txtEditor"
                            Background="{DynamicResource Theme.OutputBackground}"
                            Foreground="{DynamicResource Theme.OutputForeground}"
                            SelectionBrush="{DynamicResource Theme.OutputSelection}" />
                    </ScrollViewer>
                </Border>
                <TextBlock
                    Name="txtStatus"
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    Text="" />
            </Grid>

        </DockPanel>
    </Grid>
</Window>
